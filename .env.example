# Database
DATABASE_URL=postgresql://comlinkr:comlinkr_dev@localhost:5432/comlinkr

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=replace_with_a_random_64_character_string_for_development_only
SESSION_MAX_AGE=604800000

# Mail — Resend HTTP API (verified domain required)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SPRINT-34: Google OAuth audiences — configure every client that can initiate sign-in.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com # SPRINT-34: Web OAuth audience
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com # SPRINT-34: backward-compatible legacy alias
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_ANDROID_CLIENT_ID= # SPRINT-34: native Android OAuth client
GOOGLE_IOS_CLIENT_ID= # SPRINT-34: native iOS OAuth client
GOOGLE_EXPO_CLIENT_ID= # SPRINT-34: optional development proxy client

# SPRINT-34: Native Apple identity-token audience; do not use a Services ID here.
APPLE_BUNDLE_ID=com.comlinkr.app # SPRINT-34: native production Apple audience
# APPLE_EXTRA_AUDIENCES=host.exp.Exponent # SPRINT-34: local development only; never set in production
APPLE_CLIENT_ID= # SPRINT-34: backward-compatible legacy fallback only
APPLE_TEAM_ID= # SPRINT-34: required only for token exchange and revocation
APPLE_KEY_ID= # SPRINT-34: required only for token exchange and revocation
APPLE_PRIVATE_KEY= # SPRINT-34: quoted one-line p8 content with literal \n sequences

# CORS (dev origins for web and Expo)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://192.168.0.1:8081

# Cloudinary
CLOUDINARY_CLOUD_NAME=comlinkr
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=4000
NODE_ENV=development

# JWT (Bearer tokens for mobile / API clients; cookie sessions still supported)
JWT_SECRET=replace_with_a_strong_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_SEC=900
