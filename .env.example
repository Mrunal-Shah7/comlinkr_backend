# Database
DATABASE_URL=postgresql://comlinkr:comlinkr_dev@localhost:5432/comlinkr

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=replace_with_a_random_64_character_string_for_development_only
SESSION_MAX_AGE=604800000

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_SECURE=false

# Google OAuth (placeholder)
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Apple OAuth (placeholder)
APPLE_CLIENT_ID=placeholder
APPLE_TEAM_ID=placeholder
APPLE_KEY_ID=placeholder
APPLE_PRIVATE_KEY=placeholder

# CORS (dev origins for web and Expo)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://192.168.0.1:8081

# AWS S3
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=abc123...
AWS_REGION=us-east-2
AWS_S3_BUCKET_NAME=comlinkr-assets
AWS_S3_BUCKET_URL=https://comlinkr-assets.s3.us-east-2.amazonaws.com
# When true (default), event/avatar image URLs use presigned GETs so private buckets work. Set false if objects are public-read.
AWS_S3_PRESIGN_GET_URLS=true

# Server
PORT=4000
NODE_ENV=development

# JWT (Bearer tokens for mobile / API clients; cookie sessions still supported)
JWT_SECRET=replace_with_a_strong_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_SEC=900
